#include <Arduino.h>
#include "LGFX_Waveshare_ESP32S3_Touch_LCD_7.h"
#include <lvgl.h>
#include <demos/lv_demos.h>
#include <Wire.h>

// #define SCREEN_WIDTH  800 
// #define SCREEN_HEIGHT 480

#define HOR_RES 800
#define VER_RES 480
const uint16_t screenWidth  = 800;
const uint16_t screenHeight = 480;

static uint8_t *draw_buf_1;
static uint8_t *draw_buf_2;

/* Tick source, tell LVGL how much time (milliseconds) has passed */
static uint32_t my_tick(void)
{
    return millis();
}

void setup() {
     // Mount Serial engine over USB CDC pins
    Serial.begin(115200);
    delay(1000); 
    Serial.println("Starting Waveshare 27078 PlatformIO Boot sequence...");

    // // Force I2C initialization to secure touch interface lines
    // Wire.begin(8, 9, 400000);

    /* Initialize LVGL */
    lv_init();
    /* Set the tick callback */
    lv_tick_set_cb(my_tick);

    // Fast Octal PSRAM Frame Buffering Allocation
    uint32_t buf_size = screenWidth * 48 * sizeof(lv_color_t); 
    // draw_buf_1 = (uint8_t *)ps_malloc(buf_size);
    // draw_buf_2 = (uint8_t *)ps_malloc(buf_size);

    draw_buf_1 = (uint8_t *)heap_caps_malloc(buf_size, MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL);
    draw_buf_2 = (uint8_t *)heap_caps_malloc(buf_size, MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL);

    /* Initialize and register the LovyanGFX display driver */
    lv_lovyan_gfx_create(HOR_RES, VER_RES, draw_buf_1, buf_size, true);

    lv_display_t *disp = lv_display_get_default();
    lv_display_set_buffers(disp, draw_buf_1, draw_buf_2, buf_size, LV_DISPLAY_RENDER_MODE_PARTIAL);
    // lv_display_set_flush_cb(disp, my_disp_flush);

    // lv_obj_t *label = lv_label_create(lv_screen_active());
    // lv_label_set_text(label, "Hello PlatformIO, I'm LVGL!");
    // lv_obj_align(label, LV_ALIGN_CENTER, 0, 0 );
    #if LV_USE_DEMO_WIDGETS
      lv_demo_widgets();
    #endif
}

